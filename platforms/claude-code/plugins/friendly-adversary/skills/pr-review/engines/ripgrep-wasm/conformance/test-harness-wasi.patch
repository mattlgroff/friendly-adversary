diff --git a/crates/ignore/src/lib.rs b/crates/ignore/src/lib.rs
index 0ed4a49..d6fab63 100644
--- a/crates/ignore/src/lib.rs
+++ b/crates/ignore/src/lib.rs
@@ -524,7 +524,13 @@ mod tests {
             static TRIES: usize = 100;
             static COUNTER: AtomicUsize = AtomicUsize::new(0);
 
+            #[cfg(not(target_os = "wasi"))]
             let tmpdir = env::temp_dir();
+            // Rust's WASI stdlib intentionally does not implement
+            // `std::env::temp_dir`, even when `/tmp` is preopened by the host.
+            // The Node test runner preopens `/tmp` explicitly.
+            #[cfg(target_os = "wasi")]
+            let tmpdir = PathBuf::from("/tmp");
             for _ in 0..TRIES {
                 let count = COUNTER.fetch_add(1, Ordering::Relaxed);
                 let path = tmpdir.join("rust-ignore").join(count.to_string());
diff --git a/crates/ignore/src/walk.rs b/crates/ignore/src/walk.rs
