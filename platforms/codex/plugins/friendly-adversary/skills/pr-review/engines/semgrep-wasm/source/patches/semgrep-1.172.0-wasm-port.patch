+//Provides: caml_thread_initialize const
+function caml_thread_initialize() {
+  // noop, maybe we can look into jsoo's lwt if this is really needed someday
+}
+
+// OCaml 5 links the complete systhreads interface even though this build is
+// intentionally single-threaded. These primitives preserve the single-thread
+// model used by the original JavaScript port.
+
+//Provides: caml_single_thread_state
+var caml_single_thread_state = [0, 0, 0, 0];
+
+//Provides: caml_thread_self const
